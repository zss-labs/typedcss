{
  "name": "@typedcss/eslint-plugin",
  "version": "22.0.13",
  "description": "TypedCSS ESLint plugin",
  "author": "Refirst 11",
  "license": "MIT",
  "homepage": "https://typedcss.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zss-labs/typedcss.git",
    "directory": "packages/eslint-plugin"
  },
  "bugs": {
    "url": "https://github.com/zss-labs/typedcss/issues"
  },
  "keywords": [
    "typedcss",
    "eslint",
    "eslint-plugin",
    "oxlint",
    "lint",
    "css-in-js"
  ],
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./guard": {
      "types": "./dist/guard.d.ts",
      "default": "./dist/guard.js"
    },
    "./oxlint-plugin": "./oxlint-plugin.js"
  },
  "files": [
    "dist/",
    "oxlint-plugin.js",
    "oxlint.json"
  ],
  "bin": {
    "typedcss-lint": "bin/oxlint.js",
    "typedcsslint": "bin/typedcsslint.js"
  },
  "scripts": {
    "build": "rimraf dist && pnpm cjs",
    "cjs": "tsc --project tsconfig.cjs.json",
    "properties": "node scripts/generate-css-properties.mts"
  },
  "devDependencies": {
    "@types/eslint": "^9.6.1",
    "@types/estree": "^1.0.9",
    "@types/estree-jsx": "^1.0.5",
    "@typescript-eslint/parser": "^8.60.0",
    "@typescript-eslint/utils": "^8.60.0",
    "eslint": "^10.4.0"
  },
  "dependencies": {
    "@typedcss/oxide": "workspace:*",
    "oxlint": "1.87.0",
    "zss-engine": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
