{
  "name": "@typedcss/codemod",
  "version": "22.0.2",
  "description": "Codemods for TypedCSS: rename the styling prop or an API",
  "author": "Refirst 11",
  "license": "MIT",
  "homepage": "https://github.com/zss-labs/typedcss/tree/main/packages/css",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zss-labs/typedcss.git",
    "directory": "packages/codemod"
  },
  "bugs": {
    "url": "https://github.com/zss-labs/typedcss/issues"
  },
  "keywords": [
    "typedcss",
    "codemod",
    "migration",
    "eslint",
    "css-in-js"
  ],
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "typedcss-codemod": "bin/codemod.js"
  },
  "files": [
    "dist/",
    "bin/"
  ],
  "scripts": {
    "build": "rimraf dist && pnpm cjs",
    "cjs": "tsc --project tsconfig.cjs.json"
  },
  "dependencies": {
    "@typescript-eslint/parser": "^8.60.0",
    "eslint": "^10.4.1"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
