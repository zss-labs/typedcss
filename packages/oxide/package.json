{
  "name": "@typedcss/oxide",
  "version": "22.0.10",
  "description": "TypedCSS native compiler",
  "author": "Refirst 11",
  "license": "MIT",
  "homepage": "https://github.com/zss-labs/typedcss/tree/main/packages/css",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zss-labs/typedcss.git",
    "directory": "packages/oxide"
  },
  "bugs": {
    "url": "https://github.com/zss-labs/typedcss/issues"
  },
  "main": "index.js",
  "browser": "browser.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "browser.js"
  ],
  "napi": {
    "binaryName": "oxide",
    "targets": [
      "aarch64-linux-android",
      "aarch64-apple-darwin",
      "x86_64-apple-darwin",
      "aarch64-unknown-linux-gnu",
      "aarch64-unknown-linux-musl",
      "armv7-unknown-linux-gnueabihf",
      "x86_64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "x86_64-unknown-freebsd",
      "aarch64-pc-windows-msvc",
      "x86_64-pc-windows-msvc",
      "wasm32-wasip1-threads"
    ]
  },
  "scripts": {
    "build": "napi build --platform --release --features napi --js index.js --dts index.d.ts",
    "build:debug": "napi build --platform --features napi --js index.js --dts index.d.ts",
    "packages": "node scripts/generate-platform-packages.ts",
    "readme": "node scripts/generate-platform-readme.ts",
    "update:main": "node scripts/update-main-package.ts"
  },
  "devDependencies": {
    "@napi-rs/cli": "3.7.3",
    "@napi-rs/wasm-runtime": "1.2.4"
  },
  "engines": {
    "node": ">=22.17"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
