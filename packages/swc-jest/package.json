{
  "name": "@typedcss/swc-jest",
  "version": "22.0.5",
  "description": "TypedCSS Jest transformer on @swc/jest",
  "author": "Refirst 11",
  "license": "MIT",
  "homepage": "https://github.com/zss-labs/typedcss/tree/main/packages/css",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zss-labs/typedcss.git",
    "directory": "packages/swc-jest"
  },
  "bugs": {
    "url": "https://github.com/zss-labs/typedcss/issues"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "rimraf dist && pnpm cjs",
    "cjs": "tsc --project tsconfig.cjs.json"
  },
  "peerDependencies": {
    "@swc/core": "*"
  },
  "devDependencies": {
    "@typedcss/css": "workspace:*"
  },
  "dependencies": {
    "@typedcss/oxide": "workspace:*",
    "@swc/jest": "^0.2.39"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
