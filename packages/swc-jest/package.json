    "@swc/jest": "^0.2.39",
    "@typedcss/css": "workspace:^",
    "@typedcss/oxide": "workspace:^",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "engines": {
    "node": ">=22.17"
  }
