{
  "name": "@typedcss/init",
  "version": "22.0.2",
  "description": "One command that sets up TypedCSS: detects the bundler, installs the packages, writes the configs",
  "author": "Refirst 11",
  "license": "MIT",
  "homepage": "https://github.com/zss-labs/typedcss/tree/main/packages/css",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zss-labs/typedcss.git",
    "directory": "packages/init"
  },
  "bugs": {
    "url": "https://github.com/zss-labs/typedcss/issues"
  },
  "keywords": [
    "typedcss",
    "init",
    "setup",
    "cli",
    "css-in-js"
  ],
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "typedcss-init": "bin/init.js"
  },
  "files": [
    "dist/",
    "bin/"
  ],
  "scripts": {
    "build": "rimraf dist && pnpm cjs",
    "cjs": "tsc --project tsconfig.cjs.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
