{
  "name": "@typedcss/next-plugin",
  "version": "22.0.5",
  "description": "TypedCSS Next.js plugin",
  "author": "Refirst 11",
  "license": "MIT",
  "homepage": "https://github.com/zss-labs/typedcss/tree/main/packages/css",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zss-labs/typedcss.git",
    "directory": "packages/next-plugin"
  },
  "bugs": {
    "url": "https://github.com/zss-labs/typedcss/issues"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./loader": {
      "types": "./dist/loader.d.ts",
      "default": "./dist/loader.js"
    },
    "./css": {
      "types": "./dist/css.d.ts",
      "default": "./dist/css.js"
    },
    "./zero-virtual.css": "./zero-virtual.css"
  },
  "files": [
    "dist/",
    "zero-virtual.css"
  ],
  "scripts": {
    "build": "rimraf dist && pnpm cjs",
    "cjs": "tsc --project tsconfig.cjs.json"
  },
  "devDependencies": {
    "next": "catalog:"
  },
  "dependencies": {
    "@typedcss/eslint-plugin": "workspace:*",
    "@typedcss/oxide": "workspace:*",
    "zss-engine": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
